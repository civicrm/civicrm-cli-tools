{
    "name": "civicrm/cli-tools",
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "Tim Otten",
            "email": "totten@civicrm.org"
        }
    ],
    "require": {
        "civicrm/composer-downloads-plugin": "^3.0 || ^4.0"
    },
    "bin": [
        "bin/civistrings",
        "bin/civix",
        "bin/cv",
        "bin/coworker"
    ],
    "config": {
        "allow-plugins": {
            "civicrm/composer-downloads-plugin": true
        }
    },
    "extra": {
        "downloads": {
            "*": {
                "path": "extern/{$id}",
                "type": "phar"
            },
            "civistrings.phar": {
                "version": "2026-05-28-0ce9333d",
                "url": "https://download.civicrm.org/civistrings/civistrings.phar-2026-05-28-0ce9333d"
            },
            "civix.phar": {
                "version": "26.10.3",
                "url": "https://download.civicrm.org/civix/civix-26.10.3.phar"
            },
            "coworker.phar": {
                "version": "0.9",
                "url": "https://download.civicrm.org/coworker/coworker-0.9.phar"
            },
            "cv.phar": {
                "version": "0.3.72",
                "url": "https://download.civicrm.org/cv/cv-0.3.72.phar"
            }
        }
    }
}